BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_BASE_URL=https://demo-fapi.binance.com

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_API_ROOT=https://api.telegram.org

# Sports Value Bet Scanner (The Odds API — https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com

# State файлууд хадгалагдах директор (strategy_state.json, session_state.json).
# Railway дээр volume mount хийгээд түүний mount path-ыг энд заана — эс тэгвээс
# redeploy болгонд drawdown-ы оргил утга тэглэгдэж, нээлттэй арилжаанууд
# стратегиэ алдаж "RECOVERED" болно.
# Тохируулаагүй бол кодын хавтас руу бичнэ (түр зуурын, локал хөгжүүлэлтэд л тохиромжтой).
STATE_DIR=/data

# Log түвшин: DEBUG / INFO / WARNING / ERROR (default INFO)
LOG_LEVEL=INFO
